<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/zar3a_launch_background</item>
        <item name="android:navigationBarColor">@color/zar3a_launch_background</item>
        <!-- Android 12+ system splash: explicit brand icon, not Flutter default. -->
        <item name="android:windowSplashScreenBackground">@color/zar3a_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launch_logo</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/zar3a_launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/zar3a_launch_background</item>
        <item name="android:statusBarColor">@color/zar3a_launch_background</item>
        <item name="android:navigationBarColor">@color/zar3a_launch_background</item>
    </style>
</resources>
